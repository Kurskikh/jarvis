# Rust / Cargo 🔧
# Ignore Cargo build output, generated files, and common Rust artifacts
/target/
**/target/
/target/doc/

# Binaries and dynamic libraries
*.exe
# *.dll
*.so
*.dylib

# Static libraries
*.a
# *.lib

# Rust compilation artifacts
*.rlib
*.rmeta

# Backup files and editor temp files
*.rs.bk

# Ignore packaged crates
*.crate

# Ignore AI models, but keep their model.toml descriptors.
# The middle two lines are required: the first line excludes the model
# directories themselves, and git cannot re-include a file whose parent
# directory is excluded, so the directories have to be re-included first.
# models/app ships with a release; models/sidecar is cache the Python
# sidecars download on first run - tens of gigabytes that must never be
# tracked and never be copied into a build.
/models/sidecar/
/models/app/catalog/*
!/models/app/catalog/*/
/models/app/catalog/*/*
!/models/app/catalog/*/model.toml
# These two came with the repository before the move and still do. The intent
# classifier has no other way to exist in a fresh clone - it is not downloaded
# on demand the way the speech models are, and without the weights the
# assistant matches no commands at all.
!/models/app/catalog/all-MiniLM-L6-v2/*
!/models/app/catalog/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q/*

# What the console keeps before it overwrites a voice clip.
#
# The model never produces the same take twice, so a good clip replaced by a
# worse one cannot be got back by asking again - but this is a working copy of
# something already in git history, and it belongs on disk rather than in the
# repository.
resources/sound/voices/*-previous/
